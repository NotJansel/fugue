# THIS IS A TEMPLATE FILE. MAKE A COPY AND RENAME TO `.env` TO USE.
#
# Nuxt loads this file automatically in development. The production server does not, so either export
# these variables or start it with `pnpm start`, which passes `--env-file-if-exists=.env`.

# https://discord.com/developers
TOKEN=BOT_TOKEN

# Set to false to run the dashboard on its own, without connecting to Discord.
BOT_ENABLED=true

# osu! OAuth2 application (API v2): https://osu.ppy.sh/home/account/edit#oauth
# Register <PUBLIC_URL>/osu/callback as the application callback URL.
#
# These do double duty: users prove which osu! account is theirs through them, and the same
# credentials buy an app token for every player and beatmap lookup. There is no legacy v1 API key
# any more - without these, nothing can be looked up.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Set to false to let people use the dashboard without linking an osu! account.
# Ignored when OSU_CLIENT_ID/OSU_CLIENT_SECRET are unset, so linking is never demanded
# when it isn't possible.
OSU_LINK_REQUIRED=true

# Channel auctions started from the dashboard are posted in.
# Slash commands keep using whichever channel they were run in.
AUCTION_CHANNEL=

# --- Web dashboard ---

# Port for `pnpm dev`. The built server reads PORT (and HOST) like any other Nitro app.
WEB_PORT=8080

# Externally reachable base URL, no trailing slash. Must match the OAuth2 redirect
# registered on the Discord application, which is <PUBLIC_URL>/callback.
PUBLIC_URL=http://localhost:8080

# OAuth2 credentials from the same Discord application as TOKEN
# (Developer Portal -> OAuth2). Add <PUBLIC_URL>/callback as a redirect URI.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Guild whose members may view the dashboard. Administrators there get write access.
GUILD_ID=

# Long random string used to seal session cookies.
# Leave empty to generate one at startup, which logs everyone out on restart.
SESSION_SECRET=

# Where the JSON stores live. The three files are the same ones the Kotlin version wrote.
DATA_DIR=data
